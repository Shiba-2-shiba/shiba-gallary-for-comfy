{
  "name": "shiba-gallery-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "vue-tsc --noEmit && vite build && node harness/write-notices.mjs",
    "dev": "vite --host 0.0.0.0",
    "test:browser": "playwright test",
    "test:bundle": "node --experimental-vm-modules harness/check-bundle.mjs",
    "harness": "node harness/server.mjs"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.56.1"
  }
}
